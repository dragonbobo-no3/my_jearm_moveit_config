  <ros2_control name="jearm_system" type="system">
    <hardware>
      <plugin>je_software/JeZmqSystemHardware</plugin>
      <param name="robot_ip">192.168.0.99</param>
      <param name="pub_port">8001</param>
      <param name="sub_port">8000</param>
      <param name="command_dt">0.01</param>
      <param name="gripper_sub_topic">/end_effector_cmd_lr</param>
    </hardware>

    <joint name="joint11">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint12">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
